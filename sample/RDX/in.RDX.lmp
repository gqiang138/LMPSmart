# REAX potential for high energy CHON systems
# .....
processors * * * grid numa

units		real

atom_style	charge
read_data	data.RDX

pair_style	reax/c lmp_control
pair_coeff	* * ffield.reax.rdx H C O N

neighbor	2 bin
neigh_modify	every 10 delay 0 check no

thermo           30         	# 每30步输出一次热力学量在log文件里
thermo_style     custom step temp press etotal pe ke evdwl ecoul elong cella cellb cellc cellalpha cellbeta cellgamma vol density

fix		1 all nve
fix     2 all qeq/reax 1 0.0 10.0 1e-6 param.qeq
fix     3 all temp/berendsen 500.0 500.0 100.0              
fix     4 all reax/c/bonds 30 bonds.reax.bof 				#每30步输出键信息  
fix     5 all reax/c/species 1 5 30 species.out cutoff 2 2 0.55 cutoff 2 4 0.30 cutoff 2 3 0.65 cutoff 2 1 0.40 cutoff 4 4 0.55 cutoff 4 3 0.40 cutoff 4 1 0.55 cutoff 3 3 0.65 cutoff 3 1 0.40 cutoff 1 1 0.55 position 30 HCON.pos element H C O N
#每1步计算一次键级，每5步计算一次平均键级，每30步输出一次物质种类信息与空间位置（.pos）

timestep	     0.25           # 每0.25fs计算一次，步长

dump		1 all custom 30 dump.reax.rdx.trj id type x y z

run		300000
unfix		1
unfix		2
unfix		3
unfix 		4
unfix		5
write_data       data.RDX.final    
